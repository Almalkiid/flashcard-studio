{
    "name": "cardwright",
    "version": "0.9.0",
    "description": "Flashcards and note review with spaced repetition. FSRS scheduling, full review history, Anki style daily limits, statistics and a polished review screen for desktop and mobile.",
    "main": "main.js",
    "scripts": {
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "dev": "node esbuild.config.mjs",
        "format": "pnpm prettier --write . && pnpm eslint src/ tests/ --fix",
        "lint": "pnpm prettier --check . && pnpm eslint src/ tests/",
        "test": "pnpm jest",
        "test:e2e": "node esbuild.config.mjs production && node tests/e2e/stage-plugin.mjs && wdio run ./wdio.conf.mts",
        "validate:optimizer": "tsx tests/optimizer/compare-with-binding.ts",
        "validate": "concurrently --kill-others-on-fail -g -p \"[{name}]\" -n \"format,lint,test\" \"pnpm:format\" \"pnpm:lint\" \"pnpm:test\"",
        "precommit-msg": "echo 'Pre-commit checks...'",
        "changelog": "pnpm auto-changelog --template=compact --package --output docs/docs/changelog.md && pnpm prettier --write docs/docs/changelog.md"
    },
    "keywords": [
        "obsidian",
        "spaced repetition",
        "flashcards",
        "fsrs",
        "anki",
        "cloze"
    ],
    "author": "Almalkiid",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@open-spaced-repetition/binding": "0.5.0",
        "@types/jest": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.9.5",
        "@types/sql.js": "1.4.9",
        "@types/vhtml": "^2.2.9",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@wdio/cli": "^9.32.0",
        "@wdio/globals": "^9.31.3",
        "@wdio/local-runner": "^9.32.0",
        "@wdio/mocha-framework": "^9.32.0",
        "@wdio/spec-reporter": "^9.32.0",
        "auto-changelog": "^2.6.0",
        "concurrently": "^9.2.4",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unicorn": "^64.0.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "jest-expect-message": "^1.1.3",
        "mocha": "^10.8.2",
        "moment": "^2.30.1",
        "obsidian": "^1.13.1",
        "pre-commit": "^1.2.2",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.12",
        "tslib": "^2.8.1",
        "tsx": "^4.23.15",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.65.0",
        "vhtml": "^2.2.0",
        "wdio-obsidian-reporter": "3.2.1",
        "wdio-obsidian-service": "3.2.1"
    },
    "dependencies": {
        "@jest/globals": "^30.4.1",
        "ankipack": "0.3.1",
        "chart.js": "^4.5.1",
        "clozecraft": "^0.4.0",
        "fflate": "0.8.3",
        "fzstd": "0.1.1",
        "gridjs": "^6.2.0",
        "minimatch": "^10.2.6",
        "pagerank.js": "^1.0.2",
        "short-uuid": "^6.0.3",
        "sql.js": "1.14.2",
        "ts-fsrs": "5.4.1",
        "ts-fsrs-optimizer": "0.1.2"
    },
    "pre-commit": [
        "precommit-msg",
        "validate"
    ],
    "packageManager": "pnpm@11.6.0",
    "engines": {
        "pnpm": ">=11.6.0"
    },
    "engineStrict": true,
    "contributors": [
        "Stephen Mwangi (original author)",
        "Kyle Klus (maintainer of the original plugin)"
    ]
}
